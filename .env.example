# ── External APIs ────────────────────────────────────────────────────────────
BRIGHTDATA_API_KEY=           # Bright Data dashboard → API tokens (SERP + Web Unlocker)
BRIGHTDATA_SERP_ZONE=         # Bright Data SERP Direct API zone name
BRIGHTDATA_UNLOCKER_ZONE=     # Bright Data Web Unlocker zone name
OPENAI_API_KEY=               # platform.openai.com → API keys (extraction + embeddings)
GROK_API_KEY=                 # x.ai / Grok console → API keys (X signal tier only)

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=                 # Supabase project → Settings → API → Project URL
SUPABASE_SERVICE_ROLE_KEY=    # Settings → API → service_role key (backend scripts ONLY)
SUPABASE_ANON_KEY=            # Settings → API → anon/public key (API + web, read-only)

# ── Tuning knobs (not secrets) ───────────────────────────────────────────────
DISCOVERY_INTERVAL_SECONDS=30 # 30 while developing; crank to 300–600 for the unattended demo run
MAX_EXTRACT_PER_RUN=20        # cost cap — pipeline extract.ts never processes more than this per invocation
